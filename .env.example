# Environment Variables Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit .env files with real credentials to version control

# Required: Database Credentials
POSTGRES_PASSWORD=your_secure_password_here

# Optional: Azure Key Vault settings (for production deployments)
AZURE_KEY_VAULT_URI=https://<YOUR_VAULTNAME_HERE>.vault.azure.net/
AZURE_CLIENT_ID=<YOUR_CLIENT_ID>
AZURE_CLIENT_SECRET=<YOUR_CLIENT_SECRET>

# Optional: External Auth Providers (if enabled)
GOOGLE_CLIENT_ID=xxx
GOOGLE_CLIENT_SECRET=xxx
FACEBOOK_APP_ID=xxx
FACEBOOK_APP_SECRET=xxx
TWITTER_CONSUMER_KEY=xxx
TWITTER_CONSUMER_SECRET=xxx
APPLE_CLIENT_ID=xxx
APPLE_KEY_ID=xxx
APPLE_TEAM_ID=xxx
MICROSOFT_CLIENT_ID=xxx
MICROSOFT_CLIENT_SECRET=xxx

# Optional: SSL/TLS Certificate Configuration
# For production, use certificates from trusted authorities
SSL_CERTIFICATE_PATH=/path/to/certificate.crt
SSL_CERTIFICATE_KEY_PATH=/path/to/certificate.key

# Optional: Logging Configuration
SERILOG_MINIMUM_LEVEL=Warning
LOG_FILE_PATH=./Logs
